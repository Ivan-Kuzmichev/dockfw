# Test workload image: curl for checks, busybox httpd as a server, nft and
# nsenter to inspect/tamper with container namespaces from the host.
FROM alpine:3.22
RUN apk add --no-cache curl busybox-extras bind-tools nftables util-linux-misc \
 && mkdir -p /www && echo ok > /www/index.html
CMD ["busybox-extras", "httpd", "-f", "-p", "8080", "-h", "/www"]
