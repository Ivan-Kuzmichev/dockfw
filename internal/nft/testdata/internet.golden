table inet dockfw {
  set peers4 { type ipv4_addr; }
  set cidrs4 { type ipv4_addr; flags interval; elements = { 10.8.0.0-10.8.255.255, 192.168.1.5-192.168.1.5 }; }
  set domains4 { type ipv4_addr; flags timeout; }
  set in_peers4 { type ipv4_addr; elements = { 172.20.0.10 }; }
  set private4 { type ipv4_addr; flags interval; elements = { 10.0.0.0-10.255.255.255, 100.64.0.0-100.127.255.255, 169.254.0.0-169.254.255.255, 172.16.0.0-172.31.255.255, 192.168.0.0-192.168.255.255 }; }
  chain output {
    type filter hook output priority filter; policy drop;
    oif "lo" accept comment "dockfw policy 38699dc93d6ddbc9"
      [ meta load oifname => reg 1 ]
      [ cmp eq reg 1 0x6c6f0000000000000000000000000000 ]
      [ immediate reg 0 accept ]
    ct state established,related accept
      [ ct load state => reg 1 ]
      [ bitwise reg 1 = ( reg 1 & 0x06000000 ) ^ 0x00000000 ]
      [ cmp neq reg 1 0x00000000 ]
      [ immediate reg 0 accept ]
    meta nfproto ipv6 counter reject with icmpx type admin-prohibited
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x0a ]
      [ counter ]
      [ reject type 2 code 3 ]
    ip daddr @peers4 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 16 => reg 1 ]
      [ lookup reg 1 set peers4 id 1 ]
      [ immediate reg 0 accept ]
    ip daddr @cidrs4 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 16 => reg 1 ]
      [ lookup reg 1 set cidrs4 id 2 ]
      [ immediate reg 0 accept ]
    ip daddr @domains4 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 16 => reg 1 ]
      [ lookup reg 1 set domains4 id 3 ]
      [ immediate reg 0 accept ]
    ip daddr @private4 counter reject with icmpx type admin-prohibited
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 16 => reg 1 ]
      [ lookup reg 1 set private4 id 5 ]
      [ counter ]
      [ reject type 2 code 3 ]
    accept
      [ immediate reg 0 accept ]
  }
  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
      [ meta load iifname => reg 1 ]
      [ cmp eq reg 1 0x6c6f0000000000000000000000000000 ]
      [ immediate reg 0 accept ]
    ct state established,related accept
      [ ct load state => reg 1 ]
      [ bitwise reg 1 = ( reg 1 & 0x06000000 ) ^ 0x00000000 ]
      [ cmp neq reg 1 0x00000000 ]
      [ immediate reg 0 accept ]
    ip saddr @in_peers4 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 12 => reg 1 ]
      [ lookup reg 1 set in_peers4 id 4 ]
      [ immediate reg 0 accept ]
    ip saddr 192.168.1.10/32 meta l4proto tcp th dport 8787 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 12 => reg 1 ]
      [ cmp eq reg 1 0xc0a8010a ]
      [ meta load l4proto => reg 1 ]
      [ cmp eq reg 1 0x06 ]
      [ payload load 2b @ transport header + 2 => reg 1 ]
      [ cmp eq reg 1 0x2253 ]
      [ immediate reg 0 accept ]
    ip saddr 0.0.0.0/0 meta l4proto tcp th dport 8080 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ meta load l4proto => reg 1 ]
      [ cmp eq reg 1 0x06 ]
      [ payload load 2b @ transport header + 2 => reg 1 ]
      [ cmp eq reg 1 0x1f90 ]
      [ immediate reg 0 accept ]
    meta l4proto tcp th dport 54890 accept
      [ meta load l4proto => reg 1 ]
      [ cmp eq reg 1 0x06 ]
      [ payload load 2b @ transport header + 2 => reg 1 ]
      [ cmp eq reg 1 0xd66a ]
      [ immediate reg 0 accept ]
    meta l4proto udp th dport 54890 accept
      [ meta load l4proto => reg 1 ]
      [ cmp eq reg 1 0x11 ]
      [ payload load 2b @ transport header + 2 => reg 1 ]
      [ cmp eq reg 1 0xd66a ]
      [ immediate reg 0 accept ]
    counter reject with icmpx type admin-prohibited
      [ counter ]
      [ reject type 2 code 3 ]
  }
}
