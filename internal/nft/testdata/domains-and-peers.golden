table inet dockfw {
  set peers4 { type ipv4_addr; elements = { 172.20.0.11, 172.20.0.12 }; }
  set cidrs4 { type ipv4_addr; flags interval; }
  set domains4 { type ipv4_addr; flags timeout; elements = { 13.224.1.1 timeout 5m0s, 13.224.1.2 timeout 10m0s }; }
  set in_peers4 { type ipv4_addr; }
  chain output {
    type filter hook output priority filter; policy drop;
    oif "lo" accept comment "dockfw policy f943fcbee816a956"
      [ meta load oifname => reg 1 ]
      [ cmp eq reg 1 0x6c6f0000000000000000000000000000 ]
      [ immediate reg 0 accept ]
    ct state established,related accept
      [ ct load state => reg 1 ]
      [ bitwise reg 1 = ( reg 1 & 0x06000000 ) ^ 0x00000000 ]
      [ cmp neq reg 1 0x00000000 ]
      [ immediate reg 0 accept ]
    meta nfproto ipv6 counter reject with icmpx type admin-prohibited
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x0a ]
      [ counter ]
      [ reject type 2 code 3 ]
    ip daddr @peers4 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 16 => reg 1 ]
      [ lookup reg 1 set peers4 id 1 ]
      [ immediate reg 0 accept ]
    ip daddr @cidrs4 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 16 => reg 1 ]
      [ lookup reg 1 set cidrs4 id 2 ]
      [ immediate reg 0 accept ]
    ip daddr @domains4 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 16 => reg 1 ]
      [ lookup reg 1 set domains4 id 3 ]
      [ immediate reg 0 accept ]
    counter reject with icmpx type admin-prohibited
      [ counter ]
      [ reject type 2 code 3 ]
  }
  chain input {
    type filter hook input priority filter; policy drop;
    iif "lo" accept
      [ meta load iifname => reg 1 ]
      [ cmp eq reg 1 0x6c6f0000000000000000000000000000 ]
      [ immediate reg 0 accept ]
    ct state established,related accept
      [ ct load state => reg 1 ]
      [ bitwise reg 1 = ( reg 1 & 0x06000000 ) ^ 0x00000000 ]
      [ cmp neq reg 1 0x00000000 ]
      [ immediate reg 0 accept ]
    ip saddr @in_peers4 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 12 => reg 1 ]
      [ lookup reg 1 set in_peers4 id 4 ]
      [ immediate reg 0 accept ]
    ip saddr 192.168.1.0/24 meta l4proto tcp th dport 3000 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 12 => reg 1 ]
      [ bitwise reg 1 = ( reg 1 & 0xffffff00 ) ^ 0x00000000 ]
      [ cmp eq reg 1 0xc0a80100 ]
      [ meta load l4proto => reg 1 ]
      [ cmp eq reg 1 0x06 ]
      [ payload load 2b @ transport header + 2 => reg 1 ]
      [ cmp eq reg 1 0x0bb8 ]
      [ immediate reg 0 accept ]
    ip saddr 192.168.1.0/24 meta l4proto udp th dport 3000 accept
      [ meta load nfproto => reg 1 ]
      [ cmp eq reg 1 0x02 ]
      [ payload load 4b @ network header + 12 => reg 1 ]
      [ bitwise reg 1 = ( reg 1 & 0xffffff00 ) ^ 0x00000000 ]
      [ cmp eq reg 1 0xc0a80100 ]
      [ meta load l4proto => reg 1 ]
      [ cmp eq reg 1 0x11 ]
      [ payload load 2b @ transport header + 2 => reg 1 ]
      [ cmp eq reg 1 0x0bb8 ]
      [ immediate reg 0 accept ]
    counter reject with icmpx type admin-prohibited
      [ counter ]
      [ reject type 2 code 3 ]
  }
}
